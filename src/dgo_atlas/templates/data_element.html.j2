{% extends "base.html.j2" %}
{% from "_macros.html.j2" import certification_badge, classification_panel, responsibility_panel,
   identifier_panel, link_panel, state_badge %}
{#- One data element: the term it represents, the data set it is part of, and
    where it was derived from and into, with the term each of those represents
    so a change of meaning along the lineage shows. Classification it doesn't
    carry itself is read from its data set. -#}

{% block content %}
<div class="split">
  <article class="split__body split__body--wide">
    {%- set ds = lookup.get(element.data_set.about) %}
    <a class="back-link" href="{{ rel }}{{ element.data_set.url }}"><span aria-hidden="true">&larr;</span> {{ element.data_set.label }}</a>
    <h1 class="page-title page-title--term">{{ element.label }}</h1>
    <div class="term-meta">
      {%- set data_set %}<a href="{{ rel }}{{ element.data_set.url }}">{{ element.data_set.label }}</a>{% endset %}
      <span class="term-row__sub">{{ t("data_element.part_of", data_set=data_set) }}</span>
      {{ certification_badge(element.data_set) }}
      <a class="tag-type" href="{{ element_kind.iri }}" rel="noopener" title="{{ t("term.kind_title") }}">{{ element_kind.name }}</a>
    </div>
    {%- if element.description %}<p class="lede">{{ element.description }}</p>{% endif %}

    {#- The term whose definition gives this element's values their meaning. #}
    {%- if element.represents %}
    {%- set term = lookup.get(element.represents.about) %}
    <div class="definition-box">
      <h2 class="definition-box__label">{{ t("data_element.represents") }}</h2>
      <p class="represents__term"><a href="{{ rel }}{{ element.represents.url }}">{{ element.represents.label }}</a>
        {{ state_badge(element.represents.state) }}</p>
      {%- if term %}<p>{{ term.definition }}</p>{% endif %}
    </div>
    {%- else %}
    <p class="term-row__sub">{{ t("data_element.represents_none") }}</p>
    {%- endif %}
  </article>

  <aside class="split__aside">
    {{ responsibility_panel(element, rel, lookup, t("data_element.responsibility_empty")) }}
    {%- for title, refs in ((t("data_element.derived_from"), element.sources), (t("data_element.derived_elements"), element.derived_elements)) %}
    {%- if refs %}
    <div class="panel">
      <h2 class="panel__label">{{ title }}</h2>
      <ul class="panel-list">
        {%- for r in refs %}
        <li><a class="panel-link" href="{{ rel }}{{ r.url }}">
          <div class="panel-link__name">{{ r.label }}</div>
          {%- set other = lookup.get(r.about) %}
          <div class="panel-link__rel">
            {%- if r.data_set %}{{ r.data_set.label }}{% endif %}
            {%- if other and other.represents %} &middot; {{ t("data_element.represents_short", term=other.represents.label) }}{% endif %}</div>
        </a></li>
        {%- endfor %}
      </ul>
    </div>
    {%- endif %}
    {%- endfor %}
    {{ classification_panel(element, rel) }}
    {{ identifier_panel(element, element_kind, show_identifiers, repo_blob_url) }}
  </aside>
</div>
{% endblock %}
