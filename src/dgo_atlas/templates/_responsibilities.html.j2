{#- Responsibilities held by one bearer: on terms, data stores, data sets
    and data elements. Expects `holder`. -#}
{%- from "_macros.html.j2" import cell_label, certification_badge %}
{%- if holder.responsibilities %}
<h2 class="subhead">{{ t("responsibilities.heading") }}</h2>
<div class="term-table">
  <div class="term-row term-row--head" aria-hidden="true">
    <div>{{ t("responsibilities.column_term") }}</div><div>{{ t("responsibilities.column_role") }}</div><div>{{ t("responsibilities.column_state") }}</div><div></div>
  </div>
  <ul class="term-list">
    {%- for r in holder.responsibilities %}
    {%- if r.subject %}
    <li><a class="term-row" href="{{ rel }}{{ r.subject.url }}">
      <span class="term-row__name">{{ r.subject.label }}{% if r.subject.data_set %} <span class="term-row__sub">({{ r.subject.data_set.label }})</span>{% endif %}</span>
      <span>{{ cell_label("responsibilities.column_role") }}<span class="badge badge--{{ r.role }}">{{ r.role_label }}</span></span>
      <span class="term-row__sub">{{ cell_label("responsibilities.column_state") }}
        {%- if r.subject.state %}{{ r.subject.state | state_label }}{% else %}{{ certification_badge(r.subject) }}{% endif %}</span>
      <span class="term-row__chev" aria-hidden="true">&rsaquo;</span>
    </a></li>
    {%- else %}
    <li><div class="term-row">
      <span class="term-row__name">{{ t("responsibilities.no_term") }}</span>
      <span>{{ cell_label("responsibilities.column_role") }}<span class="badge badge--{{ r.role }}">{{ r.role_label }}</span></span>
      <span></span><span></span>
    </div></li>
    {%- endif %}
    {%- endfor %}
  </ul>
</div>
{%- endif %}
