{% extends "base.html.j2" %}
{% from "_macros.html.j2" import contact, link_panel, cell_label %}
{#- A person or organization: contact details, an organization's members,
    council seats, and the terms they hold a governance role for. -#}

{% block content %}
<div class="split">
  <article class="split__body split__body--wide">
    <div class="eyebrow">{{ agent_kind.name }}</div>
    <h1 class="page-title">{{ agent.label }}</h1>
    <div class="meta-row">
      {%- if agent.job_title %}<span>{{ agent.job_title }}</span>{% endif %}
      {%- if agent.email %}<span><a href="mailto:{{ agent.email }}">{{ agent.email }}</a></span>{% endif %}
    </div>

    {%- if agent.organization_members %}
    <h2 class="subhead">{{ t("agent.members") }}</h2>
    {%- for member in agent.organization_members %}
    {{ contact(member, rel, lookup) }}
    {%- endfor %}
    {%- endif %}

    {%- if agent.memberships %}
    <h2 class="subhead">{{ t("agent.council_seats") }}</h2>
    <div class="term-table">
      <div class="term-row term-row--office term-row--head" aria-hidden="true">
        <div>{{ t("agent.column_council") }}</div><div>{{ t("agent.column_seat") }}</div><div>{{ t("agent.column_takes_part_in") }}</div><div></div>
      </div>
      <ul class="term-list">
        {%- for seat in agent.memberships %}
        {%- set council = lookup.get(seat.council.about) %}
        <li><a class="term-row term-row--office" href="{{ rel }}{{ seat.council.url }}">
          <span class="term-row__name">{{ seat.council.label }}</span>
          <span>{{ cell_label("agent.column_seat") }}
            {%- for r in seat.council_roles or [] %}<span class="badge badge--council-role">{{ r.role_label }}</span> {% else %}<span class="term-row__sub">{{ t("agent.member") }}</span>{% endfor %}
          </span>
          <span class="term-row__sub">{{ cell_label("agent.column_takes_part_in") }}{{ council.participates_in.label if council and council.participates_in else "—" }}</span>
          <span class="term-row__chev" aria-hidden="true">&rsaquo;</span>
        </a></li>
        {%- endfor %}
      </ul>
    </div>
    {%- endif %}

    {% set holder = agent %}
    {% include "_responsibilities.html.j2" %}
    {%- if not (agent.responsibilities or agent.memberships or agent.organization_members or agent.member_of) %}
    <div class="empty-state">{{ t("agent.empty", kind=agent_kind.name) }}</div>
    {%- endif %}
  </article>

  <aside class="split__aside">
    {{ link_panel(t("agent.member_of"), agent.member_of, rel, show_state=False) }}
    {%- if show_identifiers %}
    <div class="panel">
      <h2 class="panel__label">{{ t("agent.identifier") }}</h2>
      <dl class="ref-list">
        <div class="ref-row"><dt class="ref-row__k">{{ t("agent.id") }}</dt><dd><code class="ref-row__v">{{ agent.about }}</code></dd></div>
        <div class="ref-row"><dt class="ref-row__k">{{ t("agent.iri") }}</dt><dd><code class="ref-row__v">{{ agent.iri }}</code></dd></div>
      </dl>
    </div>
    {%- endif %}
  </aside>
</div>
{% endblock %}
