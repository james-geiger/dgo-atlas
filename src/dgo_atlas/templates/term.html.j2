{% extends "base.html.j2" %}
{% from "_macros.html.j2" import state_badge, bearer, link_panel, broader_panel %}
{#- One glossary term. Sections with no data are left out rather than shown
    empty: a blank panel reads as a site bug, its absence as "not recorded". -#}

{% block content %}
{%- set state = term.state | enum %}
<div class="split">
  <article class="split__body split__body--wide">
    <a class="back-link" href="{{ rel }}terms/index.html"><span aria-hidden="true">&larr;</span> {{ t("term.back") }}</a>

    <h1 class="page-title page-title--term">{{ term.label }}</h1>

    {%- if term.name or term.alt_labels %}
    <p class="term-row__sub" style="margin:6px 0 0">
      {%- if term.name %}{{ t("term.recorded_as", name=term.name) }}{% if term.alt_labels %}. {% endif %}{% endif %}
      {%- if term.alt_labels %}{{ t("term.also_called", names=term.alt_labels | join(", ")) }}{% endif %}
    </p>
    {%- endif %}

    <div class="term-meta">
      {{ state_badge(term.state, status=True) }}
      <a class="tag-type" href="{{ term_kind.iri }}" rel="noopener"
         title="{{ t("term.kind_title") }}">{{ term_kind.name }}</a>
    </div>

    <div class="definition-box">
      <h2 class="definition-box__label">
        {{- t("state." ~ state ~ ".definition") -}}
      </h2>
      <p>{{ term.definition }}</p>
      {%- if term.definition_source %}
      <div class="definition-box__source">
        {%- set source %}<a href="{{ term.definition_source.iri }}" rel="noopener">{{ term.definition_source.label }}</a>{% endset %}
        {{ t("term.drawn_from", source=source) }}
        <span class="term-row__sub">({{ term.definition_source.iri | domain }})</span>
      </div>
      {%- endif %}
    </div>

    {%- if state == "deprecated" %}
    <div class="callout callout--required">
      <h2 class="callout__label">{{ t("term.deprecated") }}</h2>
      <p>{% if term.successor %}{% set successor %}<a href="{{ rel }}{{ term.successor.url }}">{{ term.successor.label }}</a>{% endset %}{{ t("term.deprecated_use", successor=successor) }} {% endif %}
      {{ t("term.deprecated_body") }}</p>
    </div>
    {%- endif %}

    {%- for change in term.pending_changes or [] %}
    <div class="callout callout--in_review">
      <h2 class="callout__label">{{ t("term.change_under_review") }}</h2>
      <p>{{ change.label }} <span class="term-row__sub">({{ change.process_label }})</span>. {{ t("term.change_body") }}</p>
    </div>
    {%- endfor %}

    {%- if term.predecessors %}
    {%- set predecessors %}{% for p in term.predecessors %}<a href="{{ rel }}{{ p.url }}">{{ p.label }}</a>{% if not loop.last %}, {% endif %}{% endfor %}{% endset %}
    <p class="term-row__sub">{{ t("term.replaces", terms=predecessors) }}</p>
    {%- endif %}

    <h2 class="subhead subhead--term" id="history">{{ t("term.history") }}</h2>
    {%- if term.history %}
    <ol class="history">
      {%- for h in term.history | reverse %}
      <li class="history__entry">
        <div class="history__dot" aria-hidden="true"></div>
        <div class="history__meta">{{ h.occurred_on }} &middot; {{ h.process_label }} &middot; {{ h.process.label }}</div>
        <div class="history__what">{{ h.boundary_label | capitalize }}</div>
      </li>
      {%- endfor %}
    </ol>
    {%- else %}
    <p class="history__empty">{{ t("term.history_empty") }}</p>
    {%- endif %}
  </article>

  <aside class="split__aside">
    <div class="panel">
      <h2 class="panel__label">{{ t("term.responsibility") }}</h2>
      {%- for r in term.responsibilities or [] %}
      <div class="person">
        <div class="avatar avatar--sm" style="background:{{ r.role | role_colour }}" aria-hidden="true">{{ r.bearer.label | initials }}</div>
        <div style="min-width:0">
          <span class="badge badge--{{ r.role }}">{{ r.role_label }}</span>
          {{ bearer(r.bearer, rel, lookup) }}
        </div>
      </div>
      {%- else %}
      <div class="empty-state">{{ t("term.responsibility_empty") }}</div>
      {%- endfor %}
      {%- if suggest_change_url %}
      <a class="link-cta" href="{{ suggest_change_url }}{{ term.about | urlencode }}" rel="noopener">{{ t("term.suggest_change") }} <span aria-hidden="true">&rarr;</span></a>
      {%- endif %}
    </div>

    {{ link_panel(t("term.governed_by"), term.governing_councils, rel, show_state=False) }}

    {#- What the term denotes: a class in an external ontology, named by the
        label read from that class, linked to its IRI. -#}
    {%- set st = term.semantic_type %}
    {%- if st %}
    <div class="panel">
      <h2 class="panel__label" title="{{ t("term.denotes_title") }}">{{ t("term.denotes") }}</h2>
      <a class="panel-link" href="{{ st.iri }}" rel="noopener">
        <div class="panel-link__name">{{ st.label or st.about }}</div>
        <div class="panel-link__rel">
          {%- if st.ontology %}{{ st.ontology }} &middot; {% endif %}<code>{{ st.about }}</code>
        </div>
      </a>
    </div>
    {%- endif %}

    <div class="panel">
      <h2 class="panel__label">{{ t("term.filed_under") }}</h2>
      <dl class="kv-list">
        <div class="kv"><dt class="kv__k">{{ t("term.glossary") }}</dt><dd class="kv__v"><a href="{{ rel }}{{ term.glossary.url }}">{{ term.glossary.label }}</a></dd></div>
        <div class="kv"><dt class="kv__k">{{ t("term.domain") }}</dt><dd class="kv__v"><a href="{{ rel }}{{ term.domain.url }}">{{ term.domain.label }}</a></dd></div>
        <div class="kv"><dt class="kv__k">{{ t("term.subject_area") }}</dt><dd class="kv__v"><a href="{{ rel }}{{ term.subject_area.url }}">{{ term.subject_area.label }}</a></dd></div>
      </dl>
    </div>

    {{ broader_panel(term, rel) }}
    {{ link_panel(t("term.narrower"), term.narrower, rel) }}
    {{ link_panel(t("term.value_of"), [term.value_of] if term.value_of else [], rel) }}
    {{ link_panel(t("term.values"), term.values, rel) }}
    {{ link_panel(t("term.related"), term.related, rel) }}
    {{ link_panel(t("term.replaced_by"), [term.successor] if term.successor else [], rel) }}

    {#- show_identifiers (dgo-atlas.yaml) hides the id, IRI and class; the
        source link stays, in a panel of its own. -#}
    {%- set view_source = repo_blob_url and term.source_file %}
    {%- if show_identifiers or view_source %}
    <div class="panel">
      <h2 class="panel__label">{{ t("term.identifier") if show_identifiers else t("term.source") }}</h2>
      {%- if show_identifiers %}
      <dl class="ref-list">
        <div class="ref-row">
          <dt class="ref-row__k">{{ t("term.term_id") }}</dt>
          <dd><code class="ref-row__v">{{ term.about }}</code></dd>
        </div>
        <div class="ref-row">
          <dt class="ref-row__k">{{ t("term.iri") }}</dt>
          <dd>
            <code class="permalink" id="permalink-value">{{ term.iri }}</code>
            <button class="permalink__copy" type="button"
                    data-copy-target="permalink-value"
                    data-copy-label="{{ t("term.copy_iri") }}">{{ t("term.copy_iri") }}</button>
          </dd>
        </div>
        <div class="ref-row">
          <dt class="ref-row__k">{{ t("term.class") }}</dt>
          <dd><a class="ref-row__v" href="{{ term_kind.iri }}" rel="noopener"><code>{{ term_kind.curie }}</code></a></dd>
        </div>
      </dl>
      {%- endif %}
      {%- if view_source %}
      <a class="link-cta ref-source" href="{{ repo_blob_url }}{{ term.source_file }}" rel="noopener">{{ t("term.view_source") }} <span aria-hidden="true">&rarr;</span></a>
      {%- endif %}
    </div>
    {%- endif %}
  </aside>
</div>
{% endblock %}
