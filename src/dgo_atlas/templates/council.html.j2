{% extends "base.html.j2" %}
{% from "_macros.html.j2" import data_set_rows, iri_row %}
{#- One data governance council: its members and their seats, the governance
    processes it takes part in, and the subject areas of the terms it governs. -#}

{% block content %}
<div class="split">
  <article class="split__body split__body--wide">
    <h1 class="page-title">{{ council.label }}</h1>

    <h2 class="subhead">{{ t("council.members") }}</h2>
    {#- A real table: the rows aren't links (the name and the email each link
        somewhere different), so nothing stops it being one. #}
    {%- if council.members %}
    <div class="table-scroll">
      <table class="data-table">
        <thead>
          <tr>
            <th scope="col">{{ t("council.column_name") }}</th>
            <th scope="col">{{ t("council.column_title") }}</th>
            <th scope="col">{{ t("council.column_email") }}</th>
            <th scope="col">{{ t("council.column_role") }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for seat in council.members %}
          {%- set p = lookup.get(seat.member.about) %}
          <tr>
            <th scope="row"><a class="term-row__name" href="{{ rel }}{{ seat.member.url }}">{{ seat.member.label }}</a></th>
            <td class="term-row__sub">{{ p.job_title if p and p.job_title is defined and p.job_title else "—" }}</td>
            <td class="term-row__sub">{% if p and p.email is defined and p.email %}<a href="mailto:{{ p.email }}">{{ p.email }}</a>{% else %}—{% endif %}</td>
            <td><span class="term-row__roles">
              {%- for r in seat.council_roles or [] %}<span class="badge badge--council-role">{{ r.role_label }}</span>{% else %}<span class="term-row__sub">{{ t("council.member") }}</span>{% endfor %}
            </span></td>
          </tr>
          {%- endfor %}
        </tbody>
      </table>
    </div>
    {%- else %}
    <div class="empty-state">{{ t("council.members_empty") }}</div>
    {%- endif %}

    {#- Terms are listed on their subject area's page; here each area appears once. #}
    <h2 class="subhead">{{ t("council.areas") }}</h2>
    {%- set general = (council.responsibilities or []) | rejectattr("subject") | list %}
    {%- if general %}
    <p class="council-roles">{{ t("council.general_roles") }}
      {%- for r in general %} <span class="badge badge--{{ r.role }}">{{ r.role_label }}</span>{% endfor %}</p>
    {%- endif %}
    {%- if council.governed_areas %}
    <p class="subhead-note">{{ t("council.areas_intro") }}</p>
    {%- endif %}
    <div class="area-grid">
      {%- for g in council.governed_areas or [] %}
      <a class="area-card" href="{{ rel }}{{ g.subject_area.url }}">
        <div class="area-card__bar" style="background:{{ card_accents[g.subject_area.about] }}"></div>
        <div class="area-card__name">{{ g.subject_area.label }}</div>
        <div class="area-card__meta"><span>{{ g.domain.label }}</span><span>{{ count("term", g.term_count) }}</span></div>
        {%- if g.roles %}
        <div class="area-card__roles">
          {%- for r in g.roles %}<span class="badge badge--{{ r.role }}">{{ r.role_label }}</span>{% endfor %}
        </div>
        {%- endif %}
      </a>
      {%- else %}
      <div class="empty-state">{{ t("council.areas_empty") }}</div>
      {%- endfor %}
    </div>

    {#- Data: the sets it certifies, then roles it holds on stores, sets and elements. #}
    {%- set data_roles = (council.responsibilities or []) | selectattr("subject") | rejectattr("subject.state") | list %}
    {%- if council.certified_sets or data_roles %}
    <h2 class="subhead">{{ t("council.data") }}</h2>
    <p class="subhead-note">{{ t("council.data_intro") }}</p>
    {%- if council.certified_sets %}
    <h3 class="fact__k">{{ t("council.certified_sets") }}</h3>
    {{ data_set_rows(council.certified_sets, rel, lookup, "") }}
    {%- endif %}
    {%- if data_roles %}
    {%- set holder = {"responsibilities": data_roles} %}
    {% include "_responsibilities.html.j2" %}
    {%- endif %}
    {%- endif %}
  </article>

  <aside class="split__aside">
    {#- The process chain is innermost first; show it broadest first, each
        process nested under the one it is part of. #}
    {%- if council.process_chain %}
    <div class="panel">
      <h2 class="panel__label">{{ t("council.processes") }}</h2>
      <ul class="hierarchy__tree">
        {%- for r in council.process_chain | reverse %}
        <li><a class="panel-link" href="{{ rel }}{{ r.url }}"><div class="panel-link__name">{{ r.label }}</div></a>
        {%- if not loop.last %}<ul>{% endif %}
        {%- endfor %}
        {%- for r in council.process_chain %}{% if not loop.first %}</ul>{% endif %}</li>{% endfor %}
      </ul>
    </div>
    {%- endif %}
    {%- if show_identifiers %}
    <div class="panel">
      <h2 class="panel__label">{{ t("council.identifier") }}</h2>
      <dl class="ref-list">
        <div class="ref-row"><dt class="ref-row__k">{{ t("council.id") }}</dt><dd><code class="ref-row__v">{{ council.about }}</code></dd></div>
        {{ iri_row(council.iri, t("council.iri")) }}
      </dl>
    </div>
    {%- endif %}
  </aside>
</div>
{% endblock %}
