{% extends "base.html.j2" %}
{% from "_macros.html.j2" import link_panel %}
{#- One data governance council: its members and their seats, the governance
    process it takes part in, and the subject areas of the terms it governs. -#}

{% block content %}
<div class="split">
  <article class="split__body split__body--wide">
    <div class="eyebrow">{{ council_kind.name }}</div>
    <h1 class="page-title">{{ council.label }}</h1>
    {%- if council.participates_in %}
    {%- set process %}<a href="{{ rel }}{{ council.participates_in.url }}">{{ council.participates_in.label }}</a>{% endset %}
    <p class="lede">{{ t("council.takes_part_in", process=process) }}</p>
    {%- endif %}

    <h2 class="subhead">{{ t("council.members") }}</h2>
    {#- Rows aren't links: the name and the email each link somewhere different. #}
    <div class="term-table">
      {%- if council.members %}
      <div class="term-row term-row--member term-row--head" aria-hidden="true">
        <div>{{ t("council.column_name") }}</div><div>{{ t("council.column_title") }}</div><div>{{ t("council.column_email") }}</div><div>{{ t("council.column_role") }}</div>
      </div>
      {%- endif %}
      {%- for seat in council.members or [] %}
      {%- set p = lookup.get(seat.member.about) %}
      <div class="term-row term-row--member">
        <a class="term-row__name" href="{{ rel }}{{ seat.member.url }}">{{ seat.member.label }}</a>
        <span class="term-row__sub">{{ p.job_title if p and p.job_title is defined and p.job_title else "—" }}</span>
        <span class="term-row__sub">{% if p and p.email is defined and p.email %}<a href="mailto:{{ p.email }}">{{ p.email }}</a>{% else %}—{% endif %}</span>
        <span class="term-row__roles">
          {%- for r in seat.council_roles or [] %}<span class="badge badge--council-role">{{ r.role_label }}</span>{% else %}<span class="term-row__sub">{{ t("council.member") }}</span>{% endfor %}
        </span>
      </div>
      {%- else %}
      <div class="empty-state">{{ t("council.members_empty") }}</div>
      {%- endfor %}
    </div>

    {#- Terms are listed on their subject area's page; here each area appears once. #}
    <h2 class="subhead">{{ t("council.areas") }}</h2>
    {%- set general = (council.responsibilities or []) | rejectattr("term") | list %}
    {%- if general %}
    <p class="council-roles">{{ t("council.general_roles") }}
      {%- for r in general %} <span class="badge badge--{{ r.role }}">{{ r.role_label }}</span>{% endfor %}</p>
    {%- endif %}
    {%- if council.governed_areas %}
    <p class="subhead-note">{{ t("council.areas_intro") }}</p>
    {%- endif %}
    <div class="area-grid">
      {%- for g in council.governed_areas or [] %}
      <a class="area-card" href="{{ rel }}{{ g.subject_area.url }}">
        <div class="area-card__bar" style="background:{{ card_accents[g.subject_area.about] }}"></div>
        <div class="area-card__name">{{ g.subject_area.label }}</div>
        <div class="area-card__meta"><span>{{ g.domain.label }}</span><span>{{ count("term", g.term_count) }}</span></div>
        {%- if g.roles %}
        <div class="area-card__roles">
          {%- for r in g.roles %}<span class="badge badge--{{ r.role }}">{{ r.role_label }}</span>{% endfor %}
        </div>
        {%- endif %}
      </a>
      {%- else %}
      <div class="empty-state">{{ t("council.areas_empty") }}</div>
      {%- endfor %}
    </div>
  </article>

  <aside class="split__aside">
    {{ link_panel(t("council.processes"), council.process_chain, rel, show_state=False) }}
    {%- if show_identifiers %}
    <div class="panel">
      <div class="panel__label">{{ t("council.identifier") }}</div>
      <div class="ref-row"><span class="ref-row__k">{{ t("council.id") }}</span><code class="ref-row__v">{{ council.about }}</code></div>
      <div class="ref-row"><span class="ref-row__k">{{ t("council.iri") }}</span><code class="ref-row__v">{{ council.iri }}</code></div>
    </div>
    {%- endif %}
  </aside>
</div>
{% endblock %}
